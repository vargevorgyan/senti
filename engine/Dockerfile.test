# Isolated test runner for the engine: tests and incident replays never touch the host.
FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends git ca-certificates && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:0.8 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PROJECT_ENVIRONMENT=/venv PYTHONDONTWRITEBYTECODE=1 SENTI_NO_GUI=1 SENTI_SECRET_STORE=file
WORKDIR /repo/engine
COPY engine/pyproject.toml engine/uv.lock ./
RUN uv sync --frozen --no-install-project
RUN git config --global user.email test@senti.local && git config --global user.name senti-test && git config --global init.defaultBranch main
CMD ["sh", "-c", "uv sync --frozen && uv run --no-sync pytest -q -p no:cacheprovider"]
