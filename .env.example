# Copy to .env and adjust. All values are optional.
SENTI_ORG_NAME=Acme Corp
SENTI_ADMIN_EMAIL=admin@senti.local
SENTI_ADMIN_PASSWORD=senti-admin
# Leave empty to auto-generate a random JWT secret stored in the backend volume.
SENTI_SECRET_KEY=
# Shared demo code (20 uses, 7 days). Leave empty in real deployments: invite people on the People page instead.
SENTI_DEMO_ENROLL_CODE=
# Shared multi-use enrollment codes (anyone holding one can join). Off: people join with personal one-time invites.
SENTI_ALLOW_SHARED_CODES=false
# How long a personal invite key stays valid
SENTI_INVITE_TTL_HOURS=48
# Per-device limits on the device API (requests per minute)
SENTI_JUDGE_RPM=60
SENTI_APPROVALS_RPM=20
# Corporate model (OpenAI-compatible). Defaults to the bundled Ollama container.
SENTI_CORP_MODEL_URL=http://ollama:11434/v1
SENTI_CORP_MODEL=qwen2.5:3b
SENTI_CORP_MODEL_API_KEY=
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from your network
SENTI_BIND=127.0.0.1
SENTI_TLS_HOSTS=localhost,127.0.0.1
SENTI_HTTPS_PORT=8443
SENTI_BACKEND_PORT=8000
SENTI_ADMIN_PORT=8081
# Server gateway (MCP): host folder shared with agents through Senti (files in server-files/, SQLite in server.db)
SENTI_GATEWAY_DIR=./server-data
SENTI_GATEWAY_RPM=120
# Model that turns the plain-English server policy into rules (runs rarely: use a strong one). Empty = the corporate model.
SENTI_POLICY_MODEL_URL=
SENTI_POLICY_MODEL=
SENTI_POLICY_MODEL_API_KEY=
