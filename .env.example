# Copy to .env and adjust. All values are optional.
SENTI_ORG_NAME=Acme Corp
SENTI_ADMIN_EMAIL=admin@senti.local
SENTI_ADMIN_PASSWORD=senti-admin
# Leave empty to auto-generate a random JWT secret stored in the backend volume.
SENTI_SECRET_KEY=
# Shared demo code (20 uses, 7 days). Leave empty in real deployments and create codes on the Devices page.
SENTI_DEMO_ENROLL_CODE=
# Corporate model (OpenAI-compatible). Defaults to the bundled Ollama container.
SENTI_CORP_MODEL_URL=http://ollama:11434/v1
SENTI_CORP_MODEL=qwen2.5:3b
SENTI_CORP_MODEL_API_KEY=
# 127.0.0.1 = this machine only; 0.0.0.0 = reachable from your network
SENTI_BIND=127.0.0.1
SENTI_TLS_HOSTS=localhost,127.0.0.1
SENTI_HTTPS_PORT=8443
SENTI_BACKEND_PORT=8000
SENTI_ADMIN_PORT=8081
